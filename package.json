{
  "name": "@gclift/cxms",
  "version": "3.1.0",
  "description": "Context Management System — storage, index, search, and context tree for Foundation entities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cxms": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./platform/types": {
      "types": "./dist/platform/types.d.ts",
      "import": "./dist/platform/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HushLark/cxms.git"
  },
  "license": "MIT",
  "keywords": [
    "cxms",
    "context",
    "foundation",
    "entities"
  ],
  "homepage": "https://github.com/HushLark/cxms#readme",
  "bugs": {
    "url": "https://github.com/HushLark/cxms/issues"
  }
}
